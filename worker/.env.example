# ShipFinder (Elane) API key — https://www.shipfinder.com/ais-data-api
# Primary feed: polls "Vessels in Zone" for the Fujairah polygon every
# SHIPFINDER_POLL_MS (default 60000). Terrestrial + satellite AIS with IMO,
# dimensions, draught, destination and ETA.
SHIPFINDER_API_KEY=
# fleet = poll only the tracked barges by MMSI (IMO resolved once via Vessel
# Search and cached on the barge). zone = every vessel in the Fujairah polygon.
SHIPFINDER_MODE=fleet
# Credits are spent per barge per poll in fleet mode: 100 barges every 5 min
# ≈ 28,800 credits/day. Raise this if your quota is small.
SHIPFINDER_POLL_MS=300000

# AISStream.io API key (optional, free, sparse coverage) — https://aisstream.io
AISSTREAM_API_KEY=

# Supabase project URL (same as the frontend's VITE_SUPABASE_URL)
SUPABASE_URL=

# Supabase SERVICE ROLE key — NOT the anon key. Found in Project Settings
# → API → service_role. This bypasses Row Level Security, so it must only
# ever live here (server-side), never in the frontend or a committed file.
SUPABASE_SERVICE_ROLE_KEY=
